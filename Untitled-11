\section*{ទំនាក់ទំនងលំដាប់ដោយផ្នែក (POR)}
ទំនាក់ទំនងលំដាប់ដោយផ្នែក (Partial Order Relation - POR) គឺជាទំនាក់ទំនងទាំងឡាយណាដែលមានលក្ខណៈឆ្លុះ លក្ខណៈច្រាសស៊ីមេទ្រី និងលក្ខណៈឆ្លង។ ទំនាក់ទំនងលំដាប់ពេញលេញ (Total Order Relation - TOR) គឺជា POR មួយដែលគ្រប់គូនៃធាតុទាំងអស់អាចប្រៀបធៀបគ្នាបាន។ ធាតុពិសេសៗនៃសំណុំរងនៅក្នុងសំណុំលំដាប់ដោយផ្នែក (Poset) រួមមាន៖ ធាតុទូចបំផុត/ធំបំផុត ធាតុអប្បបរមា/អតិបរមា និងគោលក្រោម/គោលលើ។

\subsection*{លក្ខណៈនៃទំនាក់ទំនងលំដាប់ដោយផ្នែក (POR)}
ទំនាក់ទំនង $\le$ លើសំណុំ $P$ មួយ គឺជាលំដាប់ដោយផ្នែក ប្រសិនបើវាមានលក្ខណៈបីយ៉ាង៖
\begin{itemize}
    \item \textbf{លក្ខណៈឆ្លុះ (Reflexive):} $a \le a$ ចំពោះគ្រប់ $a \in P$។
    \item \textbf{លក្ខណៈច្រាសស៊ីមេទ្រី (Antisymmetric):} ប្រសិនបើ $a \le b$ និង $b \le a$ នោះ $a = b$។
    \item \textbf{លក្ខណៈឆ្លង (Transitive):} ប្រសិនបើ $a \le b$ និង $b \le c$ នោះ $a \le c$។
    \item សំណុំមួយដែលមានទំនាក់ទំនង POR ហៅថា \textbf{Poset} (Partially Ordered Set)។
\end{itemize}

\subsection*{ទំនាក់ទំនងលំដាប់ពេញលេញ (TOR)}
លំដាប់ដោយផ្នែក $\le$ គឺជាលំដាប់ពេញលេញ (ឬលំដាប់លីនេអ៊ែរ) ប្រសិនបើវាបន្ថែមលក្ខខណ្ឌមួយទៀត៖
\begin{itemize}
    \item \textbf{អាចប្រៀបធៀបបាន (Comparable):} ចំពោះគ្រប់ $a, b \in P$ គេបាន $a \le b$ ឬ $b \le a$។
    \item គ្រប់គូនៃធាតុទាំងអស់គឺសុទ្ធតែអាចប្រៀបធៀបគ្នាបាន។
\end{itemize}

\subsection*{ធាតុពិសេសៗនៃសំណុំរង ($S \subseteq P$)}
តាង $(P, \le)$ ជា Poset មួយ និង $S$ ជាសំណុំរងនៃ $P$។

\subsection*{គោល (Bounds)}
\begin{itemize}
    \item \textbf{គោលក្រោម (Lower Bound):} ជាធាតុ $x \in P$ ដែល $x \le s$ ចំពោះគ្រប់ $s \in S$។
    \item \textbf{គោលលើ (Upper Bound):} ជាធាតុ $x \in P$ ដែល $s \le x$ ចំពោះគ្រប់ $s \in S$។
    \item \textbf{អាំងហ្វីមូម ឬគោលក្រោមធំបំផុត (Infimum / GLB):} ជាគោលក្រោមដែលធំជាងគេបំផុតនៃ $S$។
    \item \textbf{ស៊ុប្រេមូម ឬគោលលើតូចបំផុត (Supremum / LUB):} ជាគោលលើដែលតូចជាងគេបំផុតនៃ $S$។
\end{itemize}

% រូបភាពបង្ហាញពី Bounds (គោល)
\begin{center}
\begin{tikzpicture}[scale=0.8, every node/.style={circle, draw, inner sep=2pt}]
    % សំណុំរង S (ពណ៌ខៀវ)
    \node[fill=blue!20, label=right:$s_1$] (s1) at (0,2) {};
    \node[fill=blue!20, label=left:$s_2$] (s2) at (-1,3) {};
    \node[fill=blue!20, label=right:$s_3$] (s3) at (1,3) {};
    
    % គោលលើ និង ស៊ុប្រេមូម (ពណ៌ក្រហម)
    \node[fill=red!20, label=above right:{\textbf{Supremum (LUB)} / Upper Bound}] (lub) at (0,4.5) {};
    \node[fill=red!10, label=above:$x_{ub}$] (ub) at (0,6) {};
    
    % គោលក្រោម និង អាំងហ្វីមូម (ពណ៌បៃតង)
    \node[fill=green!30, label=below right:{\textbf{Infimum (GLB)} / Lower Bound}] (glb) at (0,0.5) {};
    \node[fill=green!10, label=below:$x_{lb}$] (lb) at (0,-1) {};
    
    % តំណភ្ជាប់ទំនាក់ទំនង
    \draw (lb) -- (glb);
    \draw (glb) -- (s1);
    \draw (s1) -- (s2);
    \draw (s1) -- (s3);
    \draw (s2) -- (lub);
    \draw (s3) -- (lub);
    \draw (lub) -- (ub);
    
    % គូសវង់ព័ទ្ធសំណុំរង S
    \draw[dashed, blue, thick] (0,2.7) circle (1.5cm);
    \node[draw=none, blue] at (-2,2.7) {$S$};
\end{tikzpicture}
\end{center}

\subsection*{ធាតុទូចបំផុត និងធំបំផុតនៅក្នុងសំណុំរង (Extremes inside the subset)}
\begin{itemize}
    \item \textbf{ធាតុទូចបំផុត (Least Element):} ជាធាតុ $m \in S$ ដែល $m \le s$ ចំពោះគ្រប់ $s \in S$។
    \item \textbf{ធាតុធំបំផុត (Greatest Element):} ជាធាតុ $m \in S$ ដែល $s \le m$ ចំពោះគ្រប់ $s \in S$។
\end{itemize}

% រូបភាពបង្ហាញពី Least Element និង Greatest Element
\begin{center}
\begin{tikzpicture}[scale=0.8, every node/.style={circle, draw, inner sep=2pt}]
    % សំណុំរង S ពណ៌ខៀវដែលមាន Least និង Greatest
    \node[fill=blue!40, label=above:{\textbf{Greatest Element}}] (greatest) at (0,4) {};
    \node[fill=blue!10, label=left:$s_1$] (s1) at (-1,2.5) {};
    \node[fill=blue!10, label=right:$s_2$] (s2) at (1,2.5) {};
    \node[fill=blue!40, label=below:{\textbf{Least Element}}] (least) at (0,1) {};
    
    % តំណភ្ជាប់
    \draw (least) -- (s1) -- (greatest);
    \draw (least) -- (s2) -- (greatest);
    
    % គូសវង់ព័ទ្ធសំណុំរង S
    \draw[dashed, blue, thick] (0,2.5) ellipse (1.8cm and 2cm);
    \node[draw=none, blue] at (-2.3,2.5) {$S$};
\end{tikzpicture}
\end{center}

\subsection*{ធាតុអប្បបរមា និងអតិបរមា (Minimal and Maximal elements)}
\begin{itemize}
    \item \textbf{ធាតុអប្បបរមា (Minimal Element):} ជាធាតុ $m \in S$ ដែលគ្មានធាតុ $s \in S$ ណាខុសពីវា ដែលផ្ទៀងផ្ទាត់ $s < m$ ឡើយ (គ្មានធាតុណាតូចជាងវាទៀតទេ)។
    \item \textbf{ធាតុអតិបរមា (Maximal Element):} ជាធាតុ $m \in S$ ដែលគ្មានធាតុ $s \in S$ ណាខុសពីវា ដែលផ្ទៀងផ្ទាត់ $m < s$ ឡើយ (គ្មានធាតុណាធំជាងវាទៀតទេ)។
\end{itemize}

% រូបភាពបង្ហាញពី Minimal Elements និង Maximal Elements (ករណីមានច្រើន និងមិនអាចប្រៀបធៀបគ្នា)
\begin{center}
\begin{tikzpicture}[scale=0.8, every node/.style={circle, draw, inner sep=2pt}]
