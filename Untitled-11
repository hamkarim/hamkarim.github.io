    \node[fill=orange!40, label=above:{\textbf{Maximal 1}}] (max1) at (-1.5,4) {};
    \node[fill=orange!40, label=above:{\textbf{Maximal 2}}] (max2) at (1.5,4) {};
    
    % ធាតុនៅកណ្តាល
    \node[fill=blue!10, label=left:$s_1$] (s1) at (-1.5,2.5) {};
    \node[fill=blue!10, label=right:$s_2$] (s2) at (1.5,2.5) {};
    
    % ធាតុអប្បបរមា (Minimal Elements) ពណ៌ស្វាយ
    \node[fill=purple!40, label=below:{\textbf{Minimal 1}}] (min1) at (-1.5,1) {};
    \node[fill=purple!40, label=below:{\textbf{Minimal 2}}] (min2) at (1.5,1) {};
    
    % តំណភ្ជាប់ដែលបង្ហាញពីការមិនអាចប្រៀបធៀបគ្នារវាងឆ្វេងនិងស្តាំផ្ទាល់
    \draw (min1) -- (s1) -- (max1);
    \draw (min2) -- (s2) -- (max2);
    \draw (min1) -- (s2); % តំណខ្វែងដើម្បីបង្កើតភាពស្មុគស្មាញនៃលំដាប់ដោយផ្នែក
    \draw (s1) -- (max2);
    
    % គូសវង់ព័ទ្ធសំណុំរង S
    \draw[dashed, blue, thick] (0,2.5) ellipse (2.8cm and 2.3cm);
    \node[draw=none, blue] at (-3.3,2.5) {$S$};
\end{tikzpicture}
\end{center}


