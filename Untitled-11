\section*{ទំនាក់ទំនងលំដាប់ផ្នែក (Partial Order Relation, POR)}
ទំនាក់ទំនងលំដាប់ផ្នែក (POR) គឺជាទំនាក់ទំនងដែលមានលក្ខណៈ \textbf{សំយោគ}, \textbf{ប្រឆាំងសមមូល}, និង \textbf{បន្តបន្ទាប់}។  
ទំនាក់ទំនងលំដាប់ពេញលេញ (Total Order Relation, TOR) គឺជា POR ដែលគ្រប់គូធាតុអាចប្រៀបធៀបបាន។  

ធាតុពិសេសនៃសំណុំមួយក្នុង poset រួមមាន៖ \textbf{ធាតុតូចបំផុត/ធាតុធំបំផុត}, \textbf{ធាតុអប្បបរមា/អតិបរមា}, និង \textbf{ព្រំខាងក្រោម/ព្រំខាងលើ}។

\subsection*{លក្ខណៈនៃ POR}
ទំនាក់ទំនង $\le$ លើសំណុំ $P$ គឺជា POR ប្រសិនបើវាមានលក្ខណៈ៖
\begin{itemize}
  \item \textbf{សំយោគ}: $a \le a$ សម្រាប់គ្រប់ $a \in P$។
  \item \textbf{ប្រឆាំងសមមូល}: ប្រសិនបើ $a \le b$ និង $b \le a$ នោះ $a = b$។
  \item \textbf{បន្តបន្ទាប់}: ប្រសិនបើ $a \le b$ និង $b \le c$ នោះ $a \le c$។
\end{itemize}

\subsection*{លក្ខណៈនៃ TOR}
POR មួយគឺជា TOR ប្រសិនបើវាមានលក្ខណៈបន្ថែម៖
\begin{itemize}
  \item \textbf{អាចប្រៀបធៀបបាន}: សម្រាប់គ្រប់ $a, b \in P$ មាន $a \le b$ ឬ $b \le a$។
\end{itemize}

\section*{ធាតុពិសេសក្នុងសំណុំ $S \subseteq P$}
អនុវត្តលើ poset $(P, \le)$ និងសំណុំរង $S \subseteq P$។

\subsection*{ព្រំ (Bounds)}
\begin{itemize}
  \item \textbf{ព្រំខាងក្រោម}: $x \in P$ ដែល $x \le s$ សម្រាប់គ្រប់ $s \in S$។
  \item \textbf{ព្រំខាងលើ}: $x \in P$ ដែល $s \le x$ សម្រាប់គ្រប់ $s \in S$។
  \item \textbf{Infimum (GLB)}: ព្រំខាងក្រោមធំបំផុត។
  \item \textbf{Supremum (LUB)}: ព្រំខាងលើតូចបំផុត។
\end{itemize}

