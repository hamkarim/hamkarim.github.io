\newcounter{nitemctr}
\newlength{\nitemlabelwidth}
\setlength{\nitemlabelwidth}{1.6em}

\ExplSyntaxOn
% ប្រកាសអថេរតាមស្តង់ដារ Expl3
\tl_new:N \l_nitem_raw_tl
\tl_new:N \l_nitem_label_tl
\tl_new:N \l_nitem_indent_raw_tl
\dim_new:N \l_nitem_indent_dim

\NewDocumentCommand{\bnitem}{}
  {
    \par\vspace{1.2ex}
    \setcounter{nitemctr}{0}
  }

\NewDocumentCommand{\enitem}{}
  {
    \par\vspace{1ex}
  }

\NewDocumentCommand{\nitem}{O{}}
  {
    \par
    \vspace{0.9ex}
    \noindent
    
    % កំណត់តម្លៃ Indent លំនាំដើម (Default)
    \dim_set:Nn \l_nitem_indent_dim { 0.8cm }
    \tl_clear:N \l_nitem_label_tl
    
    \tl_set:Nn \l_nitem_raw_tl { #1 }
    
    \tl_if_empty:NTF \l_nitem_raw_tl
      {
        % ករណីគ្មាន Option: \nitem
        \stepcounter{nitemctr}
        \tl_set:Nx \l_nitem_label_tl { \arabic{nitemctr}. }
      }
      {
        \tl_if_in:NnTF \l_nitem_raw_tl { , }
          {
            % ករណីមានដកឃ្លា និងស្លាកសញ្ញា: \nitem[A, 1.5cm]
            \seq_set_split:Nnn \l_tmpa_seq { , } { #1 }
            \tl_set:Nx \l_nitem_label_tl { \seq_item:Nn \l_tmpa_seq { 1 } }
            \tl_trim_spaces:N \l_nitem_label_tl
            
            \tl_if_empty:NT \l_nitem_label_tl 
              { 
                \stepcounter{nitemctr} 
                \tl_set:Nx \l_nitem_label_tl { \arabic{nitemctr}. } 
              }

            \tl_set:Nx \l_nitem_indent_raw_tl { \seq_item:Nn \l_tmpa_seq { 2 } }
            \tl_trim_spaces:N \l_nitem_indent_raw_tl
            
            % បំប្លែង String ទៅជា Dimension ដោយសុវត្ថិភាព
            \dim_set:Nn \l_nitem_dim_tmp { \l_nitem_indent_raw_tl }
            \dim_set_eq:NN \l_nitem_indent_dim \l_nitem_dim_tmp
          }
          {
            \tl_trim_spaces:N \l_nitem_raw_tl
            % ពិនិត្យថាជាលេខខ្នាតប្រវែង (ដាច់ខាតត្រូវផ្តើមដោយលេខ និងបញ្ចប់ដោយខ្នាត)
            \regex_match:nnTF { ^(?i)[0-9.]+(cm|pt|em|ex|in|mm)$ } { #1 }
              {
                % ករណីដាក់តែខ្នាតប្រវែង: \nitem[2cm]
                \dim_set:Nn \l_nitem_dim_tmp { #1 }
                \dim_set_eq:NN \l_nitem_indent_dim \l_nitem_dim_tmp
                \stepcounter{nitemctr}
                \tl_set:Nx \l_nitem_label_tl { \arabic{nitemctr}. }
              }
              {
                % ករណីដាក់តែស្លាកសញ្ញាផ្ទាល់ខ្លួន: \nitem[ដកស្រង់-]
                \tl_set_eq:NN \l_nitem_label_tl \l_nitem_raw_tl
              }
          }
      }
      
    % គណនាការហូតខ្សែកថាខណ្ឌ (Hanging Indent) សម្រាប់អត្ថបទដែលវែងធ្លាក់បន្ទាត់
    \hangindent=\dimexpr\l_nitem_indent_dim + \nitemlabelwidth\relax
    \hangafter=1
    
    \hspace{\l_nitem_indent_dim}
    \makebox[\nitemlabelwidth][l]{\l_nitem_label_tl}
  }
  
% បង្កើតអថេរបម្រុងទុកការពារ Error ពេលបំប្លែងខ្នាត
\dim_new:N \l_nitem_dim_tmp
\ExplSyntaxOff

